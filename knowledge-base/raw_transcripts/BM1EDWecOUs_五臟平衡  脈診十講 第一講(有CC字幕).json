    {
      "start": 74.4,
      "end": 75.94,
      "text": "各合組織"
    },
    {
      "start": 76.96,
      "end": 78.66,
      "text": "然三步者"
    },
    {
      "start": 79.0,
      "end": 80.28,
      "text": "寸官十也"
    },
    {
      "start": 80.54,
      "end": 83.62,
      "text": "所以你把脉是要先定出寸官十"
