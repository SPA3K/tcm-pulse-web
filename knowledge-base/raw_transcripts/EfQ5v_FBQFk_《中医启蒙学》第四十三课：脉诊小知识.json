{
  "source_file": "EfQ5v_FBQFk_《中医启蒙学》第四十三课：脉诊小知识.wav",
  "duration_sec": 415.1,
  "segments": [
    {
      "start": 1.55,
      "end": 4.63,
      "text": "中醫啟蒙學歡迎同學們"
    },
    {
      "start": 5.39,
      "end": 9.47,
      "text": "今天我們繼續學習中醫啟蒙學系列課長"
    },
    {
      "start": 12.95,
      "end": 18.57,
      "text": "中醫診斷學中四診無依不欲氣密切相關"
    },
    {
      "start": 18.83,
      "end": 22.93,
      "text": "中醫在診斷中審查胃氣如何"
    },
    {
      "start": 23.19,
      "end": 27.03,
      "text": "是決定疾病順利生死的關鍵"
    },
    {
      "start": 27.53,
      "end": 31.37,
      "text": "有胃氣則生,無胃氣則死"
    },
    {
      "start": 32.37,
      "end": 35.21,
      "text": "指導診斷核治療"
    },
    {
      "start": 35.47,
      "end": 38.79,
      "text": "有豬內者行豬外"
    },
    {
      "start": 39.05,
      "end": 42.63,
      "text": "審查五臟之病情"
    },
    {
      "start": 42.89,
      "end": 45.71,
      "text": "可知真氣之虛實"
    },
    {
      "start": 45.97,
      "end": 48.53,
      "text": "因此正氣的勝衰"
    },
    {
      "start": 48.79,
      "end": 51.85,
      "text": "可以從面色形態聲音"
    },
    {
      "start": 52.11,
      "end": 55.69,
      "text": "神智脉象等方面表現出來"
    },
    {
      "start": 55.69,
      "end": 61.83,
      "text": "其中以神智和脉象優為重要"
    },
    {
      "start": 62.09,
      "end": 65.93,
      "text": "神氣的存亡是生命活動的標誌"
    },
    {
      "start": 66.19,
      "end": 70.53,
      "text": "神以精氣為物質基礎"
    },
    {
      "start": 70.79,
      "end": 74.63,
      "text": "是臟腐氣血勝衰的外露真相"
    },
    {
      "start": 74.89,
      "end": 80.27,
      "text": "固約神者正氣也,神氣者冤氣也"
    },
    {
      "start": 80.99,
      "end": 85.09,
      "text": "冤氣頑固,則精神常勝"
    },
    {
      "start": 85.35,
      "end": 88.93,
      "text": "無待言言,若冤氣微弱"
    },
    {
      "start": 89.19,
      "end": 94.55,
      "text": "則神氣微趣,冤氣大虛則神氣全去"
    },
    {
      "start": 94.81,
      "end": 98.13,
      "text": "神氣則積習"
    },
    {
      "start": 98.39,
      "end": 104.29,
      "text": "固望氣色,可知內臟之勝衰"
    },
    {
      "start": 104.55,
      "end": 108.63,
      "text": "氣血之虛實,邪氣之淺身"
    },
    {
      "start": 108.83,
      "end": 115.84,
      "text": "脉诊是通過接觸人體不同部位的脉搏"
    },
    {
      "start": 116.1,
      "end": 120.46,
      "text": "以體查脉象變化的切診方法"
    },
    {
      "start": 120.72,
      "end": 126.34,
      "text": "脉象的形成與臟腐氣血密切相關"
    },
    {
      "start": 126.6,
      "end": 130.44,
      "text": "若臟腐氣血發生病變"
    },
    {
      "start": 130.7,
      "end": 133.76,
      "text": "血脉運行就會受到影響"
    },
    {
      "start": 134.02,
      "end": 136.32,
      "text": "脉象就有變化"
    },
    {
      "start": 136.62,
      "end": 139.14,
      "text": "脉诊在臨床上"
    },
    {
      "start": 139.4,
      "end": 142.46,
      "text": "可推斷疾病的進退欲後"
    },
    {
      "start": 142.98,
      "end": 146.04,
      "text": "需要掌握脉诊的時間"
    },
    {
      "start": 146.3,
      "end": 147.84,
      "text": "病人的體位"
    },
    {
      "start": 148.1,
      "end": 151.42,
      "text": "醫生的執法和指力輕重"
    },
    {
      "start": 151.68,
      "end": 153.72,
      "text": "每次按脉時間"
    },
    {
      "start": 153.98,
      "end": 156.02,
      "text": "以每次脉搏跳動"
    },
    {
      "start": 156.28,
      "end": 158.6,
      "text": "不少於50次為限"
    },
    {
      "start": 159.1,
      "end": 163.72,
      "text": "同時要了解健康人脉象的變化"
    },
    {
      "start": 165.46,
      "end": 168.8,
      "text": "才能正確的進行脉诊"
    },
    {
      "start": 170.08,
      "end": 173.4,
      "text": "國國古代醫學在診斷疾病方面"
    },
    {
      "start": 173.66,
      "end": 174.94,
      "text": "採用的脉诊"
    },
    {
      "start": 175.2,
      "end": 177.76,
      "text": "是一項獨特的診法"
    },
    {
      "start": 178.02,
      "end": 180.58,
      "text": "是中醫四診之一"
    },
    {
      "start": 180.84,
      "end": 186.2,
      "text": "是辨证論治的一種不可少的特觀依據"
    },
    {
      "start": 188.8,
      "end": 193.92,
      "text": "脉诊要求醫生由解剖心理學"
    },
    {
      "start": 194.18,
      "end": 195.98,
      "text": "等有關知識"
    },
    {
      "start": 196.58,
      "end": 197.14,
      "text": "第一"
    },
    {
      "start": 197.9,
      "end": 200.8,
      "text": "掌握關於心臟血液"
    },
    {
      "start": 201.06,
      "end": 203.54,
      "text": "和血管關係的知識"
    },
    {
      "start": 203.78,
      "end": 204.38,
      "text": "第二"
    },
    {
      "start": 204.9,
      "end": 207.86,
      "text": "掌握關於血液速度"
    },
    {
      "start": 208.38,
      "end": 209.76,
      "text": "認識的知識"
    },
    {
      "start": 210.26,
      "end": 211.04,
      "text": "第三"
    },
    {
      "start": 211.3,
      "end": 217.44,
      "text": "掌握關於呼吸和脉搏頻率關係認識的知識"
    },
    {
      "start": 218.2,
      "end": 219.22,
      "text": "第四"
    },
    {
      "start": 219.48,
      "end": 224.34,
      "text": "掌握關於切脉部位認識的知識"
    },
    {
      "start": 225.22,
      "end": 225.98,
      "text": "第五"
    },
    {
      "start": 226.34,
      "end": 231.1,
      "text": "掌握對和切脉有關因素認識的知識"
    },
    {
      "start": 231.82,
      "end": 232.98,
      "text": "內經說"
    },
    {
      "start": 233.26,
      "end": 236.38,
      "text": "這脉要常在清早"
    },
    {
      "start": 237.02,
      "end": 239.46,
      "text": "這時人的陰氣未動"
    },
    {
      "start": 239.7,
      "end": 241.18,
      "text": "陽氣未亂"
    },
    {
      "start": 241.7,
      "end": 244.62,
      "text": "才可以查出不正常的脉"
    },
    {
      "start": 245.3,
      "end": 245.98,
      "text": "又說"
    },
    {
      "start": 246.22,
      "end": 249.5,
      "text": "脉應四十氣候而變動"
    },
    {
      "start": 250.22,
      "end": 255.3,
      "text": "並指出脉诊要注意人的性格和勇氣"
    },
    {
      "start": 256.06,
      "end": 258.38,
      "text": "疲弱皮膚的致力"
    },
    {
      "start": 258.9,
      "end": 260.78,
      "text": "行之肥瘦"
    },
    {
      "start": 261.06,
      "end": 264.58,
      "text": "人的精神因素當情況"
    },
    {
      "start": 265.34,
      "end": 267.98,
      "text": "認為驚恐憂慮"
    },
    {
      "start": 268.38,
      "end": 272.18,
      "text": "動靜都會使脉發生變化"
    },
    {
      "start": 275.54,
      "end": 278.1,
      "text": "這是一張脉诊圖"
    },
    {
      "start": 280.18,
      "end": 283.66,
      "text": "這是左手的寸觀齒"
    },
    {
      "start": 284.38,
      "end": 285.5,
      "text": "相對應"
    },
    {
      "start": 286.18,
      "end": 288.14,
      "text": "心肝脾"
    },
    {
      "start": 288.5,
      "end": 289.5,
      "text": "腎因"
    },
    {
      "start": 290.34,
      "end": 292.42,
      "text": "上交中交下交"
    },
    {
      "start": 293.86,
      "end": 295.54,
      "text": "這是右手"
    },
    {
      "start": 298.72,
      "end": 301.8,
      "text": "肺膽胃腎陽"
    },
    {
      "start": 303.65,
      "end": 305.17,
      "text": "服裝塵"
    },
    {
      "start": 308.66,
      "end": 309.94,
      "text": "紅色箭頭"
    },
    {
      "start": 310.22,
      "end": 315.1,
      "text": "代表木陰生為陽"
    },
    {
      "start": 315.3,
      "end": 319.61,
      "text": "黑色箭頭"
    },
    {
      "start": 320.09,
      "end": 323.17,
      "text": "代表金水念醬"
    },
    {
      "start": 324.13,
      "end": 326.85,
      "text": "陽降化為陰"
    },
    {
      "start": 327.69,
      "end": 330.01,
      "text": "這是生"
    },
    {
      "start": 330.01,
      "end": 331.77,
      "text": "這是降"
    },
    {
      "start": 332.09,
      "end": 337.06,
      "text": "寸觀齒"
    },
    {
      "start": 337.06,
      "end": 352.76,
      "text": "中一把脉是取寸口脉"
    },
    {
      "start": 353.0,
      "end": 356.0,
      "text": "也就是寸觀齒"
    },
    {
      "start": 356.0,
      "end": 357.44,
      "text": "這三個部分"
    },
    {
      "start": 357.68,
      "end": 360.6,
      "text": "而左右手的脉具有不同的意義"
    },
    {
      "start": 361.0,
      "end": 362.28,
      "text": "左手屬陰"
    },
    {
      "start": 362.28,
      "end": 363.24,
      "text": "主血"
    },
    {
      "start": 363.24,
      "end": 364.92,
      "text": "右手屬陽"
    },
    {
      "start": 364.92,
      "end": 365.88,
      "text": "主氣"
    },
    {
      "start": 366.28,
      "end": 367.12,
      "text": "因此"
    },
    {
      "start": 367.2,
      "end": 369.96,
      "text": "兩手的脉相並不竟然相同"
    },
    {
      "start": 370.16,
      "end": 370.96,
      "text": "此外"
    },
    {
      "start": 371.16,
      "end": 374.24,
      "text": "左右手對應的臟腑功能也不一樣"
    },
    {
      "start": 374.72,
      "end": 377.68,
      "text": "右手從手腕至手肘的順序是"
    },
    {
      "start": 377.68,
      "end": 378.36,
      "text": "肺"
    },
    {
      "start": 378.64,
      "end": 379.24,
      "text": "皮"
    },
    {
      "start": 379.36,
      "end": 380.04,
      "text": "腎"
    },
    {
      "start": 380.48,
      "end": 383.36,
      "text": "右手的腎代表的是身職功能"
    },
    {
      "start": 383.72,
      "end": 385.32,
      "text": "左手則是心"
    },
    {
      "start": 385.64,
      "end": 386.24,
      "text": "肝"
    },
    {
      "start": 386.4,
      "end": 387.0,
      "text": "腎"
    },
    {
      "start": 387.36,
      "end": 390.16,
      "text": "左手的腎代表的是排泄功能"
    },
    {
      "start": 393.14,
      "end": 394.02,
      "text": "作業"
    },
    {
      "start": 394.7,
      "end": 397.74,
      "text": "中醫診斷與什麼有關"
    },
    {
      "start": 397.98,
      "end": 403.24,
      "text": "如何準確脉诊"
    },
    {
      "start": 405.94,
      "end": 408.54,
      "text": "謝謝觀看中醫啟蒙學"
    },
    {
      "start": 409.22,
      "end": 410.66,
      "text": "同學們再見"
    }
  ],
  "full_text": "中醫啟蒙學歡迎同學們\n今天我們繼續學習中醫啟蒙學系列課長\n中醫診斷學中四診無依不欲氣密切相關\n中醫在診斷中審查胃氣如何\n是決定疾病順利生死的關鍵\n有胃氣則生,無胃氣則死\n指導診斷核治療\n有豬內者行豬外\n審查五臟之病情\n可知真氣之虛實\n因此正氣的勝衰\n可以從面色形態聲音\n神智脉象等方面表現出來\n其中以神智和脉象優為重要\n神氣的存亡是生命活動的標誌\n神以精氣為物質基礎\n是臟腐氣血勝衰的外露真相\n固約神者正氣也,神氣者冤氣也\n冤氣頑固,則精神常勝\n無待言言,若冤氣微弱\n則神氣微趣,冤氣大虛則神氣全去\n神氣則積習\n固望氣色,可知內臟之勝衰\n氣血之虛實,邪氣之淺身\n脉诊是通過接觸人體不同部位的脉搏\n以體查脉象變化的切診方法\n脉象的形成與臟腐氣血密切相關\n若臟腐氣血發生病變\n血脉運行就會受到影響\n脉象就有變化\n脉诊在臨床上\n可推斷疾病的進退欲後\n需要掌握脉诊的時間\n病人的體位\n醫生的執法和指力輕重\n每次按脉時間\n以每次脉搏跳動\n不少於50次為限\n同時要了解健康人脉象的變化\n才能正確的進行脉诊\n國國古代醫學在診斷疾病方面\n採用的脉诊\n是一項獨特的診法\n是中醫四診之一\n是辨证論治的一種不可少的特觀依據\n脉诊要求醫生由解剖心理學\n等有關知識\n第一\n掌握關於心臟血液\n和血管關係的知識\n第二\n掌握關於血液速度\n認識的知識\n第三\n掌握關於呼吸和脉搏頻率關係認識的知識\n第四\n掌握關於切脉部位認識的知識\n第五\n掌握對和切脉有關因素認識的知識\n內經說\n這脉要常在清早\n這時人的陰氣未動\n陽氣未亂\n才可以查出不正常的脉\n又說\n脉應四十氣候而變動\n並指出脉诊要注意人的性格和勇氣\n疲弱皮膚的致力\n行之肥瘦\n人的精神因素當情況\n認為驚恐憂慮\n動靜都會使脉發生變化\n這是一張脉诊圖\n這是左手的寸觀齒\n相對應\n心肝脾\n腎因\n上交中交下交\n這是右手\n肺膽胃腎陽\n服裝塵\n紅色箭頭\n代表木陰生為陽\n黑色箭頭\n代表金水念醬\n陽降化為陰\n這是生\n這是降\n寸觀齒\n中一把脉是取寸口脉\n也就是寸觀齒\n這三個部分\n而左右手的脉具有不同的意義\n左手屬陰\n主血\n右手屬陽\n主氣\n因此\n兩手的脉相並不竟然相同\n此外\n左右手對應的臟腑功能也不一樣\n右手從手腕至手肘的順序是\n肺\n皮\n腎\n右手的腎代表的是身職功能\n左手則是心\n肝\n腎\n左手的腎代表的是排泄功能\n作業\n中醫診斷與什麼有關\n如何準確脉诊\n謝謝觀看中醫啟蒙學\n同學們再見"
}