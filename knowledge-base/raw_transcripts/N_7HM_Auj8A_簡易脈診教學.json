    },
    {
      "start": 115.14,
      "end": 116.5,
      "text": "淺的脉枕"
    },
    {
      "start": 116.62,
      "end": 118.22,
      "text": "不要太高的脉枕"
    },
    {
      "start": 118.22,
      "end": 119.06,
      "text": "墊在下面"
    },
    {
      "start": 119.06,
      "end": 119.9,
      "text": "這叫撐"
    },
    {
      "start": 119.9,
      "end": 120.38,
      "text": "好"
    },
    {
      "start": 120.38,
      "end": 121.02,
      "text": "新"
    },
    {
      "start": 121.02,
      "end": 121.34,
      "text": "好"
    },
    {
      "start": 121.34,
      "end": 122.86,
      "text": "新與新等高"
    },
    {
      "start": 123.46,
      "end": 124.26,
      "text": "支"
    },
    {
      "start": 124.26,
      "end": 125.22,
      "text": "手腕打"
    },
    {
      "start": 125.22,
      "end": 126.06,
      "text": "直"
    },
    {
      "start": 126.06,
      "end": 127.46,
      "text": "仰掌直腕"
    },
    {
      "start": 127.46,
      "end": 128.26,
      "text": "撐"
    },
    {
      "start": 128.26,
      "end": 130.26,
      "text": "用另外一隻手撐住他的手腕"
    },
    {
      "start": 130.26,
      "end": 131.06,
      "text": "新支撐"
    },
    {
      "start": 131.06,
      "end": 131.9,
      "text": "再來呢"
    },
    {
      "start": 131.9,
      "end": 134.06,
      "text": "再來的口訣就是觀攻腹"
    },
    {
      "start": 134.82,
      "end": 136.22,
      "text": "因為你把脉把得好"
    },
    {
      "start": 136.22,
      "end": 137.26,
      "text": "就好像過五官管"
    },
    {
      "start": 137.26,
      "end": 139.06,
      "text": "斬六將像觀攻一樣"
    },
    {
      "start": 139.06,
      "end": 140.34,
      "text": "比觀攻他爸爸更厲害"
    },
    {
      "start": 140.34,
      "end": 141.42,
      "text": "叫觀攻腹"
    },
    {
      "start": 141.42,
      "end": 141.86,
      "text": "所以呢"
    },
    {
      "start": 141.86,
      "end": 143.26,
      "text": "什麼叫觀呢"
    },
    {
      "start": 143.26,
      "end": 144.86,
      "text": "我們現在要佈指"
    },
    {
      "start": 144.86,
      "end": 146.42,
      "text": "要把我們的手指頭放上去了"
    },
    {
      "start": 147.02,
      "end": 148.54,
      "text": "首先要找到先找到觀"
    },
    {
      "start": 148.54,
      "end": 149.22,
      "text": "好"
    },
    {
      "start": 149.22,
      "end": 149.7,
      "text": "觀"
    },
    {
      "start": 149.7,
      "end": 151.06,
      "text": "就是老骨精塗的地方"
    },
    {
      "start": 151.06,
      "end": 152.14,
      "text": "找到觀"
    },
    {
      "start": 152.14,
      "end": 153.94,
      "text": "觀是你中指擺的位置"
    },
    {
      "start": 153.94,
      "end": 154.62,
      "text": "這叫觀"
    },
    {
      "start": 154.62,
      "end": 154.98,
      "text": "好"
    },
    {
      "start": 156.3,
      "end": 156.7,
      "text": "然後呢"
    },
    {
      "start": 156.7,
      "end": 158.3,
      "text": "你食指放到寸的位置"
    },
    {
      "start": 159.06,
      "end": 159.42,
      "text": "然後呢"
    },
    {
      "start": 159.42,
      "end": 160.26,
      "text": "無名指"
    },
    {
      "start": 160.26,
      "end": 160.5,
      "text": "好"
    },
    {
      "start": 160.5,
      "end": 162.02,
      "text": "放到尺的位置"
    },
    {
      "start": 162.02,
      "end": 162.42,
      "text": "而且呢"
    },
    {
      "start": 162.42,
      "end": 163.98,
      "text": "這三指呢"
    },
    {
      "start": 163.98,
      "end": 165.98,
      "text": "要平均"
    },
    {
      "start": 165.98,
      "end": 167.5,
      "text": "在同一條直線上"
    },
    {
      "start": 167.5,
      "end": 169.1,
      "text": "這就是為什麼我們說觀攻腹"
    },
    {
      "start": 169.1,
      "end": 169.98,
      "text": "你的手要成這樣"
    },
    {
      "start": 169.98,
      "end": 171.06,
      "text": "攻形像這樣"
    },
    {
      "start": 171.9,
      "end": 173.26,
      "text": "而不是這樣"
    },
    {
      "start": 173.26,
      "end": 174.3,
      "text": "這樣不對了嘛"
    },
    {
      "start": 174.3,
      "end": 175.86,
      "text": "所以要成攻形"
    },
    {
      "start": 176.5,
      "end": 176.9,
      "text": "然後呢"
    },
    {
      "start": 176.9,
      "end": 177.54,
      "text": "記得"
    },
    {
      "start": 177.54,
      "end": 178.58,
      "text": "這有個大拇指"
    },
    {
      "start": 178.58,
      "end": 180.18,
      "text": "大拇指要在下面支撐著"
    },
    {
      "start": 182.8,
      "end": 185.36,
      "text": "隨之觀攻腹的觀"
    },
    {
      "start": 185.36,
      "end": 186.68,
      "text": "那麼什麼叫負呢"
    },
    {
      "start": 186.68,
      "end": 187.48,
      "text": "負就是"
    },
    {
      "start": 187.48,
      "end": 189.16,
      "text": "你把脉的時候要用你的指腹"
    },
    {
      "start": 190.72,
      "end": 193.08,
      "text": "指腹去按壓"
    },
    {
      "start": 193.08,
      "end": 194.76,
      "text": "而不要變成這樣子打"
