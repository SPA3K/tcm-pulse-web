{
  "source_file": "N_7HM_Auj8A_簡易脈診教學.wav",
  "duration_sec": 295.8,
  "segments": [
    {
      "start": 0.0,
      "end": 2.56,
      "text": "各位時時現在來教大家怎麼把脉"
    },
    {
      "start": 2.82,
      "end": 4.86,
      "text": "凌蘇九證十二元有講"
    },
    {
      "start": 4.86,
      "end": 6.92,
      "text": "凡將用針必先整脉"
    },
    {
      "start": 6.92,
      "end": 9.48,
      "text": "這告訴我們把脉的重要性"
    },
    {
      "start": 9.48,
      "end": 11.78,
      "text": "因為你必須先知道患者的狀況"
    },
    {
      "start": 11.78,
      "end": 13.82,
      "text": "你常決定你要選什麼穴刀"
    },
    {
      "start": 13.82,
      "end": 16.64,
      "text": "就像吸藥用藥之前也要有vital sign"
    },
    {
      "start": 17.16,
      "end": 18.68,
      "text": "甚至也要leave a data"
    },
    {
      "start": 18.68,
      "end": 19.46,
      "text": "那麼"
    },
    {
      "start": 20.22,
      "end": 21.76,
      "text": "桂林谷本上的論也講"
    },
    {
      "start": 21.76,
      "end": 24.06,
      "text": "脉奶气血是先進"
    },
    {
      "start": 24.06,
      "end": 25.08,
      "text": "等於說呢"
    },
    {
      "start": 25.08,
      "end": 25.86,
      "text": "脉"
    },
    {
      "start": 25.86,
      "end": 28.16,
      "text": "等於他把身體的訊息告訴我們"
    },
    {
      "start": 28.56,
      "end": 32.52,
      "text": "所以我們把脉的時候可以可以知道說到底這個患者的气血變化"
    },
    {
      "start": 32.52,
      "end": 34.32,
      "text": "怎麼樣到底是變好或變壞"
    },
    {
      "start": 34.82,
      "end": 37.12,
      "text": "而不純粹是光用症狀來表現"
    },
    {
      "start": 37.38,
      "end": 38.92,
      "text": "所以你會更準確的掌握到"
    },
    {
      "start": 39.16,
      "end": 42.76,
      "text": "患者身體內在五臟六腑气血變化如何"
    },
    {
      "start": 43.0,
      "end": 46.08,
      "text": "你才更能夠掌握療效所以把脉是非常重要的"
    },
    {
      "start": 46.34,
      "end": 48.64,
      "text": "那我先教各位把脉的方法"
    },
    {
      "start": 49.16,
      "end": 50.44,
      "text": "我沒有口訣"
    },
    {
      "start": 50.68,
      "end": 51.72,
      "text": "脉座"
    },
    {
      "start": 51.96,
      "end": 52.74,
      "text": "新支撐"
    },
    {
      "start": 53.24,
      "end": 54.28,
      "text": "官公婦"
    },
    {
      "start": 54.52,
      "end": 55.04,
      "text": "舉行案"
    },
    {
      "start": 55.3,
      "end": 57.34,
      "text": "舉行案就是服眾城的案法"
    },
    {
      "start": 57.54,
      "end": 58.54,
      "text": "那什麼叫脉座呢"
    },
    {
      "start": 58.54,
      "end": 59.86,
      "text": "就是說把脉的時候呢"
    },
    {
      "start": 59.86,
      "end": 62.16,
      "text": "我們基本上換的做用做之"
    },
    {
      "start": 62.16,
      "end": 63.18,
      "text": "脉座"
    },
    {
      "start": 64.2,
      "end": 64.98,
      "text": "那當然你"
    },
    {
      "start": 65.24,
      "end": 66.52,
      "text": "如果把脉把得好"
    },
    {
      "start": 67.28,
      "end": 69.84,
      "text": "你這個診所或是你的門診這樣可能會增加"
    },
    {
      "start": 69.84,
      "end": 71.12,
      "text": "所以你變成脉座"
    },
    {
      "start": 71.12,
      "end": 72.66,
      "text": "各位可以這樣來寄"
    },
    {
      "start": 72.66,
      "end": 74.44,
      "text": "然後新支撐"
    },
    {
      "start": 74.44,
      "end": 75.98,
      "text": "當你脉座"
    },
    {
      "start": 75.98,
      "end": 77.0,
      "text": "診所的生意好的"
    },
    {
      "start": 77.0,
      "end": 78.04,
      "text": "診所患者多了"
    },
    {
      "start": 78.04,
      "end": 79.3,
      "text": "你可能會有新的支撐"
    },
    {
      "start": 79.3,
      "end": 81.62,
      "text": "從一般的醫師變主之醫師或變主任"
    },
    {
      "start": 82.12,
      "end": 83.66,
      "text": "或是你又變院長"
    },
    {
      "start": 83.66,
      "end": 84.94,
      "text": "所以新支撐"
    },
    {
      "start": 84.94,
      "end": 86.74,
      "text": "什麼叫新支撐呢"
    },
    {
      "start": 86.94,
      "end": 87.94,
      "text": "新第一個"
    },
    {
      "start": 88.46,
      "end": 90.26,
      "text": "手臂要更新等高"
    },
    {
      "start": 90.26,
      "end": 91.66,
      "text": "更新臟等高"
    },
    {
      "start": 92.46,
      "end": 94.46,
      "text": "那支就是直"
    },
    {
      "start": 94.46,
      "end": 95.98,
      "text": "這代表說我們的手腕要"
    },
    {
      "start": 95.98,
      "end": 96.78,
      "text": "仰掌"
    },
    {
      "start": 96.78,
      "end": 98.02,
      "text": "仰掌而不是這樣把"
    },
    {
      "start": 98.02,
      "end": 99.1,
      "text": "一定是仰掌"
    },
    {
      "start": 99.1,
      "end": 100.3,
      "text": "然後直腕"
    },
    {
      "start": 100.3,
      "end": 101.3,
      "text": "手腕要打直"
    },
    {
      "start": 101.3,
      "end": 103.3,
      "text": "而不是往上或往下"
    },
    {
      "start": 104.02,
      "end": 106.7,
      "text": "所以新支撐的直就是手臂要打直"
    },
    {
      "start": 107.06,
      "end": 107.86,
      "text": "撐呢"
    },
    {
      "start": 107.86,
      "end": 109.86,
      "text": "就是你要用另外一隻手"
    },
    {
      "start": 110.26,
      "end": 111.3,
      "text": "在他下方"
    },
    {
      "start": 111.3,
      "end": 113.06,
      "text": "手腕要做個支撐"
    },
    {
      "start": 113.3,
      "end": 114.14,
      "text": "或者是"
    },
    {
      "start": 114.14,
      "end": 115.14,
