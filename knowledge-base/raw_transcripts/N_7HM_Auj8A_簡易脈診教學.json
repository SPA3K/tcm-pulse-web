    {
      "start": 195.88,
      "end": 196.36,
      "text": "指尖"
    },
    {
      "start": 196.36,
      "end": 196.96,
      "text": "不用指尖"
    },
    {
      "start": 196.96,
      "end": 198.84,
      "text": "因為我有指腹"
    },
    {
      "start": 198.84,
      "end": 201.16,
      "text": "才能夠讓你充分的掌握到"
