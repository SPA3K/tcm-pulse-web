    {
      "start": 211.36,
      "end": 212.04,
      "text": "做個指點"
    },
    {
      "start": 212.04,
      "end": 214.76,
      "text": "這樣才能夠平均的施壓"
    },
    {
      "start": 214.76,
      "end": 216.04,
      "text": "所以從上面往下拍"
    },
    {
      "start": 216.04,
      "end": 217.4,
      "text": "好來"
    },
    {
      "start": 217.4,
      "end": 218.56,
      "text": "我的手臂第一個"
    },
    {
      "start": 218.56,
      "end": 219.32,
      "text": "很重要一點"
    },
    {
      "start": 219.32,
      "end": 220.2,
      "text": "還有就是說"
    },
    {
      "start": 220.2,
      "end": 221.64,
      "text": "我們手指頭"
    },
    {
      "start": 221.64,
      "end": 223.88,
      "text": "一二三指的間隔要一樣"
    },
    {
      "start": 223.88,
      "end": 225.84,
      "text": "你不要變成這樣子"
    },
    {
      "start": 225.84,
      "end": 227.52,
      "text": "等於十指中指之間"
    },
    {
      "start": 227.52,
      "end": 229.4,
      "text": "假設是AVC三點"
    },
    {
      "start": 229.4,
      "end": 231.4,
      "text": "這時候你AV要等VC"
    },
    {
      "start": 231.4,
      "end": 232.8,
      "text": "你不能這樣"
    },
    {
      "start": 232.8,
      "end": 234.56,
      "text": "你不能這樣"
    },
    {
      "start": 234.56,
      "end": 236.0,
      "text": "稍微一點這樣都不太對"
    },
    {
      "start": 237.16,
      "end": 238.24,
      "text": "所以呢"
    },
    {
      "start": 238.24,
      "end": 239.16,
      "text": "再來就是我剛說的"
    },
    {
      "start": 239.16,
      "end": 240.56,
      "text": "要在一直線上"
    },
    {
      "start": 240.56,
      "end": 241.56,
      "text": "所以我們才要做"
    },
    {
      "start": 241.56,
      "end": 242.4,
      "text": "攻行"
    },
    {
      "start": 242.4,
      "end": 243.2,
      "text": "觀攻腹"
    },
    {
      "start": 243.2,
      "end": 244.56,
      "text": "好來"
    },
    {
      "start": 244.56,
      "end": 246.04,
      "text": "接下來我們要出力了"
    },
    {
      "start": 246.04,
      "end": 246.88,
      "text": "首先出力的話"
    },
    {
      "start": 246.88,
      "end": 249.08,
      "text": "你要有三個層次"
    },
    {
      "start": 249.08,
      "end": 250.44,
      "text": "叫舉循按"
    },
    {
      "start": 250.44,
      "end": 251.84,
      "text": "那我們用比較無白話文來講"
    },
    {
      "start": 251.84,
      "end": 252.28,
      "text": "就是"
    },
    {
      "start": 255.28,
      "end": 257.48,
      "text": "各位可以看到我用三種力道"
    },
    {
      "start": 257.48,
      "end": 258.76,
      "text": "腹"
    },
    {
      "start": 258.76,
      "end": 260.72,
      "text": "就是輕許"
    },
    {
      "start": 260.72,
      "end": 262.76,
      "text": "輕輕的完全不出力"
    },
    {
      "start": 262.76,
      "end": 263.6,
      "text": "這時候要感覺是"
    },
    {
      "start": 263.6,
      "end": 264.68,
      "text": "春脉的感覺"
    },
    {
      "start": 264.68,
      "end": 265.96,
      "text": "的脉動"
    },
    {
      "start": 265.96,
      "end": 266.28,
      "text": "腹"
    },
    {
      "start": 266.32,
      "end": 267.4,
      "text": "然後再來的中"
    },
    {
      "start": 267.4,
      "end": 268.52,
      "text": "稍微出一點力"
    },
    {
      "start": 269.76,
      "end": 270.44,
      "text": "中曲"
    },
    {
      "start": 270.44,
      "end": 272.64,
      "text": "我要感覺是关脉的力道"
    },
    {
      "start": 272.64,
      "end": 273.6,
      "text": "再來"
    },
    {
      "start": 273.6,
      "end": 274.76,
      "text": "成"
    },
    {
      "start": 274.76,
      "end": 276.48,
      "text": "這叫重曲"
    },
    {
      "start": 276.48,
      "end": 278.28,
      "text": "我要取的是尺脉力道"
    },
    {
