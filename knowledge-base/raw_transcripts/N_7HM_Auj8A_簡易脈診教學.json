      "end": 202.24,
      "text": "脉整的訊息"
    },
    {
      "start": 203.48,
      "end": 206.32,
      "text": "所以觀攻腹"
    },
    {
      "start": 206.32,
      "end": 207.04,
      "text": "接下來我們就可以"
    },
    {
      "start": 207.08,
      "end": 208.2,
      "text": "各位看再看一次"
    },
    {
      "start": 208.2,
      "end": 209.36,
      "text": "這邊"
    },
    {
      "start": 209.36,
      "end": 211.36,
      "text": "這邊我要用個大拇指支撐在這邊"
