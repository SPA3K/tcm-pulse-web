{
  "source_file": "bESMQzzw-J8_長短脈講解.wav",
  "duration_sec": 553.9,
  "segments": [
    {
      "start": 0.0,
      "end": 2.42,
      "text": "今天要講的是其他藏脉 藏脉跟短脉"
    },
    {
      "start": 2.42,
      "end": 4.42,
      "text": "你們翻開課本 脉整耐一頁"
    },
    {
      "start": 5.72,
      "end": 7.22,
      "text": "自由的照地極業嗎?"
    },
    {
      "start": 7.22,
      "end": 8.2,
      "text": "十五頁"
    },
    {
      "start": 8.2,
      "end": 9.52,
      "text": "十五頁 好 OK"
    },
    {
      "start": 9.9,
      "end": 11.64,
      "text": "藏脉 短脉 一起講"
    },
    {
      "start": 11.64,
      "end": 15.84,
      "text": "藏脉就是脉形 手尾 劇場 超過本位"
    },
    {
      "start": 16.98,
      "end": 19.28,
      "text": "短脉就是短嘛 很容易理解"
    },
    {
      "start": 19.28,
      "end": 20.48,
      "text": "不能滿步"
    },
    {
      "start": 21.16,
      "end": 23.12,
      "text": "等一下我會徒刑跟大家講"
    },
    {
      "start": 23.12,
      "end": 25.28,
      "text": "那你想 既然是藏脉"
    },
    {
      "start": 25.28,
      "end": 29.84,
      "text": "代表第一個 好的方面來看就是氣很順暢"
    },
    {
      "start": 30.0,
      "end": 32.0,
      "text": "藏 而且跳起來沒什麼病的脉"
    },
    {
      "start": 32.0,
      "end": 34.32,
      "text": "沒有什麼血脉 沒有緊脉 沒有滑脉"
    },
    {
      "start": 34.32,
      "end": 36.52,
      "text": "基本上還是認定它還 OK"
    },
    {
      "start": 37.4,
      "end": 39.76,
      "text": "那另外一種 如果出現在左關脉"
    },
    {
      "start": 39.76,
      "end": 42.26,
      "text": "就代表它肝癢有過剩的喔"
    },
    {
      "start": 42.86,
      "end": 44.36,
      "text": "才會超過啊"
    },
    {
      "start": 44.76,
      "end": 46.76,
      "text": "有多出來才會變長脉"
    },
    {
      "start": 47.26,
      "end": 49.26,
      "text": "所以可能就會氣盛有餘"
    },
    {
      "start": 49.76,
      "end": 50.66,
      "text": "所以你就記得"
    },
    {
      "start": 50.66,
      "end": 53.52,
      "text": "出現長脉基本上就是有多的才會變長"
    },
    {
      "start": 55.57,
      "end": 57.81,
      "text": "我本來這條線 我只需要五公分就好"
    },
    {
      "start": 57.81,
      "end": 59.45,
      "text": "結果你怎麼給我七公分"
    },
    {
      "start": 59.45,
      "end": 61.45,
      "text": "代表你有多的才會變這樣子啊"
    },
    {
      "start": 61.95,
      "end": 63.95,
      "text": "那短脉就是顛倒過來"
    },
    {
      "start": 63.95,
      "end": 65.95,
      "text": "手尾劇短不能滿步"
    },
    {
      "start": 65.95,
      "end": 67.45,
      "text": "那短脉要分兩種可能性"
    },
    {
      "start": 67.45,
      "end": 68.95,
      "text": "一個是真的不夠"
    },
    {
      "start": 68.95,
      "end": 71.95,
      "text": "叫無力為虛損 為氣損"
    },
    {
      "start": 71.95,
      "end": 73.45,
      "text": "那有一種情況是怎麼樣"
    },
    {
      "start": 73.45,
      "end": 75.45,
      "text": "因為不通的 堵塞不通水"
    },
    {
      "start": 75.45,
      "end": 76.95,
      "text": "局部就看起來就不夠了"
    },
    {
      "start": 76.95,
      "end": 77.95,
      "text": "好像說"
    },
    {
      "start": 78.75,
      "end": 80.75,
      "text": "就有點像說 我們打開水龍頭"
    },
    {
      "start": 81.75,
      "end": 83.75,
      "text": "怎麼會一滴一滴的水而已"
    },
    {
      "start": 83.75,
      "end": 85.75,
      "text": "怎麼沒有辦法像以前這樣很大的水"
    },
    {
      "start": 86.75,
      "end": 89.25,
      "text": "兩種可能性嘛 一個是不夠"
    },
    {
      "start": 89.25,
      "end": 90.75,
      "text": "剛好停水的"
    },
    {
      "start": 90.75,
      "end": 93.25,
      "text": "第二種是水管堵住了"
    },
    {
      "start": 93.25,
      "end": 95.25,
      "text": "所以在這個末端才會變成怎麼樣"
    },
    {
      "start": 95.25,
      "end": 97.25,
      "text": "變成沒有水 知道嗎"
    },
    {
      "start": 97.25,
      "end": 98.25,
      "text": "所以當你摸到短的時候"
    },
    {
      "start": 98.25,
      "end": 100.25,
      "text": "兩種可能性 一個是真的虛的"
    },
    {
      "start": 100.25,
      "end": 102.25,
      "text": "一種是有不同"
    },
    {
      "start": 103.25,
      "end": 104.25,
      "text": "你要再去判斷"
    },
    {
      "start": 106.25,
      "end": 107.75,
      "text": "所以有力為氣欲"
    },
    {
      "start": 107.75,
      "end": 109.25,
      "text": "無力為氣損"
    },
    {
      "start": 109.25,
      "end": 110.75,
      "text": "那我們看個圖就可以理解了"
    },
    {
      "start": 111.75,
      "end": 113.75,
      "text": "假設我們拔拔不是這樣拔嗎"
    },
    {
      "start": 113.75,
      "end": 115.25,
      "text": "你摸到的感覺是這樣子"
    },
    {
      "start": 115.75,
      "end": 117.25,
      "text": "假設這個十指這個脉"
    },
    {
      "start": 117.25,
      "end": 118.75,
      "text": "這是正常 以這個為標準"
    },
    {
      "start": 118.75,
      "end": 119.75,
      "text": "這是正常"
    },
    {
      "start": 119.75,
      "end": 124.05,
      "text": "那我們中指"
    },
    {
      "start": 124.05,
      "end": 126.05,
      "text": "這一個就叫長脉 知道嗎"
    },
    {
      "start": 127.55,
      "end": 128.55,
      "text": "它比較長喔"
    },
    {
      "start": 130.05,
      "end": 132.05,
      "text": "你看喔 這一個"
    },
    {
      "start": 132.05,
      "end": 135.05,
      "text": "它旁邊 手指頭兩邊都還有空隙喔"
    },
    {
      "start": 135.05,
      "end": 137.05,
      "text": "可是這個幾乎就是"
    },
    {
      "start": 137.05,
      "end": 139.05,
      "text": "橫跨到 跨到兩邊去的"
    },
    {
      "start": 140.05,
      "end": 141.05,
      "text": "這就叫長脉了"
    },
    {
      "start": 142.05,
      "end": 143.05,
      "text": "這個是什麼"
    },
    {
      "start": 143.05,
      "end": 144.05,
      "text": "這個也是長脉"
    },
    {
      "start": 145.05,
      "end": 146.05,
      "text": "但是它"
    },
    {
      "start": 146.55,
      "end": 148.55,
      "text": "細而長 知道嗎"
    },
    {
      "start": 149.55,
      "end": 150.55,
      "text": "這個很常見喔"
    },
    {
      "start": 150.55,
      "end": 152.55,
      "text": "我們很多同學也有喔"
    },
    {
      "start": 152.55,
      "end": 153.55,
      "text": "細細長長的"
    },
    {
      "start": 154.55,
      "end": 155.55,
      "text": "那叫做什麼"
    },
    {
      "start": 155.55,
      "end": 157.55,
      "text": "隱虛陽抗"
    },
    {
      "start": 159.55,
      "end": 161.55,
      "text": "乾燥 其中可能性"
    },
    {
      "start": 161.55,
      "end": 163.55,
      "text": "比如說它同時出現在兩個部位"
    },
    {
      "start": 163.55,
      "end": 166.8,
      "text": "那兩個部位都隱虛"
    },
    {
      "start": 166.8,
      "end": 168.8,
      "text": "或者是它可能硬硬的"
    },
    {
      "start": 168.8,
      "end": 169.8,
      "text": "它可能就怎麼樣"
    },
    {
      "start": 169.8,
      "end": 171.8,
      "text": "因為循環不良"
    },
    {
      "start": 171.8,
      "end": 174.8,
      "text": "器官有某些部位有點蓋化"
    },
    {
      "start": 174.8,
      "end": 176.8,
      "text": "跟氣質化的"
    },
    {
      "start": 176.8,
      "end": 177.8,
      "text": "那它就會變成什麼"
    },
    {
      "start": 177.8,
      "end": 179.8,
      "text": "有點也是不通證 所以會變成長脉"
    },
    {
      "start": 179.8,
      "end": 181.8,
      "text": "可是是細而長"
    },
    {
      "start": 181.8,
      "end": 183.8,
      "text": "等於說一開始只是隱虛"
    },
    {
      "start": 183.8,
      "end": 184.8,
      "text": "後來某些部位"
    },
    {
      "start": 184.8,
      "end": 186.8,
      "text": "可能開始蓋化 氣質化"
    },
    {
      "start": 186.8,
      "end": 188.8,
      "text": "所以它也會變得有點不通"
    },
    {
      "start": 188.8,
      "end": 190.8,
      "text": "就會變成長脉"
    },
    {
      "start": 190.8,
      "end": 191.8,
      "text": "因為實證"
    },
    {
      "start": 191.8,
      "end": 192.8,
      "text": "要解嗎"
    },
    {
      "start": 192.8,
      "end": 193.8,
      "text": "就氣盛猶豫"
    },
    {
      "start": 193.8,
      "end": 195.8,
      "text": "因為我水分跟"
    },
    {
      "start": 195.8,
      "end": 197.8,
      "text": "營養液進不去嘛"
    },
    {
      "start": 197.8,
      "end": 198.8,
      "text": "好像我肝臟已經硬化了"
    },
    {
      "start": 198.8,
      "end": 199.8,
      "text": "是不是血液循環"
    },
    {
      "start": 199.8,
      "end": 201.8,
      "text": "就沒辦法比較沒辦法進去"
    },
    {
      "start": 201.8,
      "end": 202.8,
      "text": "或者是肝門靜脉那邊的人"
    },
    {
      "start": 202.8,
      "end": 203.8,
      "text": "堵塞不通"
    },
    {
      "start": 203.8,
      "end": 205.8,
      "text": "是不是血液就流動不順了"
    },
    {
      "start": 205.8,
      "end": 207.8,
      "text": "就也會出現那次實證"
    },
    {
      "start": 207.8,
      "end": 209.8,
      "text": "就變成長脉"
    },
    {
      "start": 209.8,
      "end": 210.8,
      "text": "它沒有進去"
    },
    {
      "start": 210.8,
      "end": 211.8,
      "text": "蓋進去的地方"
    },
    {
      "start": 211.8,
      "end": 213.8,
      "text": "變成多出來的"
    },
    {
      "start": 213.8,
      "end": 214.8,
      "text": "知道嗎"
    },
    {
      "start": 214.8,
      "end": 216.8,
      "text": "所以就會細而長"
    },
    {
      "start": 216.8,
      "end": 218.8,
      "text": "來 再複習一下"
    },
    {
      "start": 218.8,
      "end": 219.8,
      "text": "這是一般的"
    },
    {
      "start": 219.8,
      "end": 220.8,
      "text": "這已經是長脉了"
    },
    {
      "start": 220.8,
      "end": 222.8,
      "text": "這比較偏實證"
    },
    {
      "start": 222.8,
      "end": 224.8,
      "text": "這個是比較偏向於是"
    },
    {
      "start": 224.8,
      "end": 227.8,
      "text": "虛那個本虛標識"
    },
    {
      "start": 229.8,
      "end": 231.8,
      "text": "細長脉"
    },
    {
      "start": 231.8,
      "end": 232.8,
      "text": "好 來"
    },
    {
      "start": 232.8,
      "end": 233.8,
      "text": "那這邊無名指這個"
    },
    {
      "start": 233.8,
      "end": 234.8,
      "text": "這就是短脉"
    },
    {
      "start": 234.8,
      "end": 235.8,
      "text": "你知道嗎"
    },
    {
      "start": 235.8,
      "end": 236.8,
      "text": "你把的時候會覺得"
    },
    {
      "start": 236.8,
      "end": 238.8,
      "text": "這是什麼變短呢"
    },
    {
      "start": 238.8,
      "end": 240.8,
      "text": "不能滿布"
    },
    {
      "start": 240.8,
      "end": 241.8,
      "text": "那這就是什麼"
    },
    {
      "start": 241.8,
      "end": 245.34,
      "text": "細而短"
    },
    {
      "start": 245.34,
      "end": 246.34,
      "text": "像上次我們有學生在問"
    },
    {
      "start": 246.34,
      "end": 247.34,
      "text": "像這個"
    },
    {
      "start": 247.34,
      "end": 248.34,
      "text": "我就用百合"
    },
    {
      "start": 248.34,
      "end": 249.34,
      "text": "如果又出脉磨到"
    },
    {
      "start": 249.34,
      "end": 251.34,
      "text": "我就用百合"
    },
    {
      "start": 251.34,
      "end": 252.34,
      "text": "像這種如果磨到"
    },
    {
      "start": 252.34,
      "end": 253.34,
      "text": "我就會用一些"
    },
    {
      "start": 253.34,
      "end": 255.34,
      "text": "滋陰清熱的"
    },
    {
      "start": 255.34,
      "end": 256.34,
      "text": "跨越好幾個杖子"
    },
    {
      "start": 256.34,
      "end": 257.34,
      "text": "我就用滋母"
    },
    {
      "start": 257.34,
      "end": 258.34,
      "text": "你知道嗎"
    },
    {
      "start": 258.34,
      "end": 259.34,
      "text": "因為滋母是"
    },
    {
      "start": 259.34,
      "end": 262.34,
      "text": "肺 皮 腎"
    },
    {
      "start": 262.34,
      "end": 264.34,
      "text": "都入到這三個鏡頭"
    },
    {
      "start": 264.34,
      "end": 266.34,
      "text": "那如果是在左關"
    },
    {
      "start": 266.34,
      "end": 267.34,
      "text": "左齒摸到長脉"
    },
    {
      "start": 267.34,
      "end": 269.34,
      "text": "我就會用生地"
    },
    {
      "start": 269.34,
      "end": 271.34,
      "text": "細而長的"
    },
    {
      "start": 271.34,
      "end": 278.3,
      "text": "ok 這樣理解嗎"
    },
    {
      "start": 278.3,
      "end": 280.3,
      "text": "正長脉 長脉"
    },
    {
      "start": 280.3,
      "end": 282.3,
      "text": "細而長"
    },
    {
      "start": 282.3,
      "end": 283.3,
      "text": "短脉"
    },
    {
      "start": 283.3,
      "end": 291.06,
      "text": "細而短"
    },
    {
      "start": 291.06,
      "end": 293.06,
      "text": "今天的時間"
    },
    {
      "start": 293.06,
      "end": 295.06,
      "text": "好 我們趕快看一下就好"
    },
    {
      "start": 295.06,
      "end": 296.06,
      "text": "來"
    },
    {
      "start": 296.06,
      "end": 298.06,
      "text": "我們還是透過萬壽永的書"
    },
    {
      "start": 298.06,
      "end": 300.06,
      "text": "來跟大家講一下"
    },
    {
      "start": 300.06,
      "end": 301.06,
      "text": "我做個比較"
    },
    {
      "start": 301.06,
      "end": 302.06,
      "text": "長短脉"
    },
    {
      "start": 302.06,
      "end": 303.06,
      "text": "長脉為羊"
    },
    {
      "start": 303.06,
      "end": 305.06,
      "text": "很正常 多出來就是羊"
    },
    {
      "start": 305.06,
      "end": 307.06,
      "text": "不足就是陰"
    },
    {
      "start": 307.06,
      "end": 309.06,
      "text": "這個在比較上是這樣比較的"
    },
    {
      "start": 309.06,
      "end": 311.06,
      "text": "然後呢"
    },
    {
      "start": 311.06,
      "end": 313.06,
      "text": "有趣的是在這裡"
    },
    {
      "start": 313.06,
      "end": 315.06,
      "text": "生短脉長"
    },
    {
      "start": 315.06,
      "end": 317.06,
      "text": "中損人"
    },
    {
      "start": 317.06,
      "end": 319.06,
      "text": "中醫的哲學一直告訴我們"
    },
    {
      "start": 319.06,
      "end": 321.06,
      "text": "你不要那種很極端相反的問題"
    },
    {
      "start": 321.06,
      "end": 323.06,
      "text": "的問題出現"
    },
    {
      "start": 323.06,
      "end": 324.06,
      "text": "一個女生大失血"
    },
    {
      "start": 324.06,
      "end": 325.06,
      "text": "產後大失血"
    },
    {
      "start": 325.06,
      "end": 326.06,
      "text": "就脉多大脉 十脉"
    },
    {
      "start": 326.06,
      "end": 328.06,
      "text": "糟糕 這個反而也危險"
    },
    {
      "start": 328.06,
      "end": 329.06,
      "text": "因為失完那麼多血"
    },
    {
      "start": 329.06,
      "end": 331.06,
      "text": "應該是虛證"
    },
    {
      "start": 331.06,
      "end": 333.06,
      "text": "同樣的 人就短短小小的"
    },
    {
      "start": 333.06,
      "end": 335.06,
      "text": "脉卻都很長"
    },
    {
      "start": 335.06,
      "end": 337.06,
      "text": "氣盛有餘的脉 這個反而不好"
    },
    {
      "start": 337.06,
      "end": 339.06,
      "text": "你看他說什麼"
    },
    {
      "start": 339.06,
      "end": 342.06,
      "text": "大約生入子 活到二十歲左右而已"
    },
    {
      "start": 342.06,
      "end": 344.06,
      "text": "五代的人可能這樣子"
    },
    {
      "start": 344.06,
      "end": 347.06,
      "text": "過此當於鬼為靈"
    },
    {
      "start": 347.06,
      "end": 348.06,
      "text": "就是你過了二十歲"
    },
    {
      "start": 348.06,
      "end": 349.06,
      "text": "可能就跟鬼很接近"
    },
    {
      "start": 349.06,
      "end": 351.06,
      "text": "你就隨時要去當鬼就知道了"
    },
    {
      "start": 351.06,
      "end": 353.06,
      "text": "講得很難去"
    },
    {
      "start": 353.06,
      "end": 355.06,
      "text": "就是這種人可能活不長"
    },
    {
      "start": 355.06,
      "end": 356.06,
      "text": "同樣的"
    },
    {
      "start": 356.06,
      "end": 358.06,
      "text": "短脉為陰"
    },
    {
      "start": 358.06,
      "end": 360.06,
      "text": "相不足 代表是不足"
    },
    {
      "start": 360.06,
      "end": 362.06,
      "text": "短脉就代表有不足"
    },
    {
      "start": 362.06,
      "end": 363.06,
      "text": "只是這個補足"
    },
    {
      "start": 363.06,
      "end": 364.06,
      "text": "到底是不通"
    },
    {
      "start": 364.06,
      "end": 365.06,
      "text": "導致的不足"
    },
    {
      "start": 365.06,
      "end": 368.06,
      "text": "還是純粹的不足"
    },
    {
      "start": 368.06,
      "end": 369.06,
      "text": "我剛講過嘛"
    },
    {
      "start": 369.06,
      "end": 370.06,
      "text": "水龍頭沒有水"
    },
    {
      "start": 370.06,
      "end": 372.06,
      "text": "一種是真的沒有水的"
    },
    {
      "start": 372.06,
      "end": 373.06,
      "text": "一種是堵塞的"
    },
    {
      "start": 373.06,
      "end": 376.06,
      "text": "所以他才會水都滴不出來"
    },
    {
      "start": 376.06,
      "end": 379.06,
      "text": "身長 脉短 食堪憂"
    },
    {
      "start": 379.06,
      "end": 380.06,
      "text": "這個也是我臨床上"
    },
    {
      "start": 380.06,
      "end": 381.06,
      "text": "常跟患者講的"
    },
    {
      "start": 381.06,
      "end": 383.06,
      "text": "一個壯壯的人"
    },
    {
      "start": 383.06,
      "end": 384.06,
      "text": "壯風的患者"
    },
    {
      "start": 384.06,
      "end": 385.06,
      "text": "把下去居然"
    },
    {
      "start": 385.06,
      "end": 387.06,
      "text": "脉多弱 脉或短脉"
    },
    {
      "start": 387.06,
      "end": 389.06,
      "text": "我都會跟他們講"
    },
    {
      "start": 390.06,
      "end": 392.06,
      "text": "老虎的身體"
    },
    {
      "start": 392.06,
      "end": 394.06,
      "text": "老鼠的心臟"
    },
    {
      "start": 395.06,
      "end": 397.06,
      "text": "這樣當然風險很高"
    },
    {
      "start": 397.06,
      "end": 398.06,
      "text": "不合理嘛"
    },
    {
      "start": 398.06,
      "end": 399.06,
      "text": "所以"
    },
    {
      "start": 399.06,
      "end": 402.06,
      "text": "身長 脉短 食堪憂"
    },
    {
      "start": 402.06,
      "end": 404.06,
      "text": "怎麼年育三死 命難留"
    },
    {
      "start": 404.06,
      "end": 407.06,
      "text": "都代表這種都是不好的"
    },
    {
      "start": 408.06,
      "end": 410.06,
      "text": "然後短油 尺寸 營養分"
    },
    {
      "start": 410.06,
      "end": 411.06,
      "text": "就是你還要分"
    },
    {
      "start": 411.06,
      "end": 413.06,
      "text": "在寸关尺什麼地方"
    },
    {
      "start": 414.06,
      "end": 416.06,
      "text": "長脉"
    },
    {
      "start": 416.06,
      "end": 417.06,
      "text": "長脉的脉陰"
    },
    {
      "start": 417.06,
      "end": 418.06,
      "text": "為什麼會出現長脉"
    },
    {
      "start": 418.06,
      "end": 421.06,
      "text": "就是因為氣血 蔥銀 唯有餘"
    },
    {
      "start": 421.06,
      "end": 423.06,
      "text": "多出來才會變長脉"
    },
    {
      "start": 424.06,
      "end": 427.06,
      "text": "什麼 顛及神牆 陽勢望"
    },
    {
      "start": 427.06,
      "end": 429.06,
      "text": "會有顛及 顛顯"
    },
    {
      "start": 429.06,
      "end": 431.06,
      "text": "然後可能會抗憤"
    },
    {
      "start": 431.06,
      "end": 432.06,
      "text": "然後陽勢望"
    },
    {
      "start": 432.06,
      "end": 433.06,
      "text": "可能天天就想要交配"
    },
    {
      "start": 433.06,
      "end": 434.06,
      "text": "你知道嗎"
    },
    {
      "start": 434.06,
      "end": 436.06,
      "text": "陽牆不倒"
    },
    {
      "start": 436.06,
      "end": 437.06,
      "text": "這不是好事"
    },
    {
      "start": 437.06,
      "end": 439.06,
      "text": "陽牆不倒不是好事"
    },
    {
      "start": 439.06,
      "end": 441.06,
      "text": "然後生熱煩躁 腦充血"
    },
    {
      "start": 441.06,
      "end": 444.06,
      "text": "脉域本位是名場"
    },
    {
      "start": 444.06,
      "end": 446.06,
      "text": "脉域本位 來"
    },
    {
      "start": 446.06,
      "end": 447.06,
      "text": "剛剛看過的"
    },
    {
      "start": 447.06,
      "end": 449.06,
      "text": "這個是脉域本位的"
    },
    {
      "start": 449.06,
      "end": 450.06,
      "text": "對不對"
    },
    {
      "start": 450.06,
      "end": 451.06,
      "text": "你本來要把關脉久"
    },
    {
      "start": 451.06,
      "end": 452.06,
      "text": "它居然跨越到寸"
    },
    {
      "start": 452.06,
      "end": 453.06,
      "text": "跨越到尺去的"
    },
    {
      "start": 453.06,
      "end": 455.06,
      "text": "叫脉域本位"
    },
    {
      "start": 455.06,
      "end": 459.37,
      "text": "那短脉的脉脉象"
    },
    {
      "start": 459.37,
      "end": 460.37,
      "text": "你看 它是顛倒"
    },
    {
      "start": 460.37,
      "end": 463.37,
      "text": "它說兇腹 頭痛 腦 貧血"
    },
    {
      "start": 463.37,
      "end": 464.37,
      "text": "這邊是充血"
    },
    {
      "start": 464.37,
      "end": 466.37,
      "text": "這邊是貧血"
    },
    {
      "start": 466.37,
      "end": 468.37,
      "text": "氣致 素食 三交涵"
    },
    {
      "start": 468.37,
      "end": 470.37,
      "text": "酒傷 神石 陰拒中"
    },
    {
      "start": 470.37,
      "end": 474.37,
      "text": "氣血兩挫 並短脉"
    },
    {
      "start": 474.37,
      "end": 477.37,
      "text": "一個是過拖 一個是不足"
    },
    {
      "start": 477.37,
      "end": 480.81,
      "text": "如果在不同的部位"
    },
    {
      "start": 480.81,
      "end": 483.81,
      "text": "左吋如果有腸脉代表食熱"
    },
    {
      "start": 483.81,
      "end": 486.81,
      "text": "心經有食熱"
    },
    {
      "start": 486.81,
      "end": 489.81,
      "text": "舌肝 煙痛 正可觀"
    },
    {
      "start": 489.81,
      "end": 491.81,
      "text": "心開肖於舌 不是嗎"
    },
    {
      "start": 491.81,
      "end": 493.81,
      "text": "右吋脉腸煮氣痛"
    },
    {
      "start": 493.81,
      "end": 495.81,
      "text": "因為肺煮氣"
    },
    {
      "start": 495.81,
      "end": 497.81,
      "text": "它可能就會胸痛"
    },
    {
      "start": 497.81,
      "end": 498.81,
      "text": "大致上講一下"
    },
    {
      "start": 498.81,
      "end": 500.81,
      "text": "因為我們時間比較不夠"
    },
    {
      "start": 500.81,
      "end": 502.81,
      "text": "如果是短脉就怎麼樣"
    },
    {
      "start": 502.81,
      "end": 505.81,
      "text": "短脉無力 氣血虛"
    },
    {
      "start": 505.81,
      "end": 506.81,
      "text": "有力就是什麼"
    },
    {
      "start": 506.81,
      "end": 509.81,
      "text": "氣傭 彈石肌"
    },
    {
      "start": 509.81,
      "end": 511.81,
      "text": "而且長短就是這樣"
    },
    {
      "start": 511.81,
      "end": 513.81,
      "text": "你理論上不一定會把得到"
    },
    {
      "start": 513.81,
      "end": 514.81,
      "text": "但是你要會"
    },
    {
      "start": 514.81,
      "end": 517.81,
      "text": "因為有時候我們看多患者"
    },
    {
      "start": 517.81,
      "end": 518.81,
      "text": "還是會遇到"
    },
    {
      "start": 518.81,
      "end": 523.34,
      "text": "長脉這邊"
    },
    {
      "start": 523.34,
      "end": 525.34,
      "text": "齒短之症 病複症"
    },
    {
      "start": 525.34,
      "end": 528.34,
      "text": "橡膠虛 虛病 厚當敏"
    },
    {
      "start": 528.34,
      "end": 529.34,
      "text": "再告訴你"
    },
    {
      "start": 529.34,
      "end": 531.34,
      "text": "短脉會有什麼症狀"
    },
    {
      "start": 531.34,
      "end": 533.34,
      "text": "發現在齒就是病複症"
    },
    {
      "start": 533.34,
      "end": 535.34,
      "text": "下膠虛病"
    },
    {
      "start": 535.34,
      "end": 537.34,
      "text": "OK 好"
    },
    {
      "start": 537.34,
      "end": 541.34,
      "text": "我們 lecture 今天講到這邊"
    },
    {
      "start": 541.34,
      "end": 543.34,
      "text": "等一下一樣要大家來實習一下"
    },
    {
      "start": 543.34,
      "end": 546.34,
      "text": "互相幫各位把脉"
    },
    {
      "start": 546.34,
      "end": 548.34,
      "text": "當然大家的防護要做好"
    },
    {
      "start": 548.34,
      "end": 549.34,
      "text": "好不好"
    },
    {
      "start": 549.34,
      "end": 551.34,
      "text": "那在這邊為止"
    },
    {
      "start": 551.34,
      "end": 553.34,
      "text": "我們可以先結束了"
    }
