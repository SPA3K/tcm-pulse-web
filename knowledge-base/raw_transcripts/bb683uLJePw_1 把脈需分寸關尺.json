      "end": 162.3,
      "text": "並不多"
    },
    {
      "start": 162.3,
      "end": 163.6,
      "text": "所以各位一定要先了解"
    },
    {
      "start": 163.6,
      "end": 166.1,
      "text": "先分寸关尺"
    },
    {
      "start": 166.1,
      "end": 167.4,
      "text": "你要懂得分"
    },
    {
      "start": 167.4,
      "end": 169.5,
      "text": "然後再分服忠誠"
    },
    {
      "start": 169.5,
      "end": 171.6,
      "text": "這個概念一定要先有了"
    },
    {
      "start": 171.7,
      "end": 174.1,
      "text": "我們才能進入到下一步"
    },
    {
      "start": 174.1,
      "end": 176.4,
      "text": "接下來我再教各位"
    },
    {
      "start": 176.4,
      "end": 177.7,
      "text": "怎麼去定位"
    },
    {
      "start": 177.7,
      "end": 179.7,
      "text": "怎麼去按壓"
    },
    {
      "start": 179.7,
