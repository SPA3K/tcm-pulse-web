    {
      "start": 575.76,
      "end": 577.46,
      "text": "那個要背尿才會"
    },
    {
      "start": 577.46,
      "end": 578.36,
      "text": "不會那麼頻尿"
    },
    {
      "start": 578.36,
      "end": 580.06,
      "text": "這句話是有問題的"
    },
    {
      "start": 580.06,
      "end": 581.46,
      "text": "所謂背尿是說"
    },
    {
      "start": 581.46,
      "end": 582.46,
      "text": "你不要說"
    },
    {
      "start": 582.46,
      "end": 583.36,
      "text": "一點點"
    },
    {
      "start": 583.36,
      "end": 585.06,
      "text": "他半個小時你就去"
    },
    {
      "start": 585.06,
      "end": 586.26,
      "text": "你可以等一下"
    },
    {
      "start": 586.26,
      "end": 587.26,
      "text": "但是你"
    },
    {
      "start": 587.26,
      "end": 588.66,
      "text": "我們所謂背尿是"
    },
    {
      "start": 588.66,
      "end": 589.66,
      "text": "兩三個小時"
    },
    {
      "start": 589.66,
      "end": 591.46,
      "text": "你已經把外面脹起來了"
    },
    {
      "start": 591.46,
      "end": 592.26,
      "text": "你就說"
