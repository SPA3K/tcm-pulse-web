    {
      "start": 592.26,
      "end": 594.06,
      "text": "你一背壓力夠大"
    },
    {
      "start": 594.06,
      "end": 595.46,
      "text": "你就發癮"
    },
    {
      "start": 595.46,
      "end": 597.96,
      "text": "所以他那個要講清楚"
    },
    {
      "start": 597.96,
      "end": 599.66,
      "text": "所以那個此外這個地方"
    },
    {
      "start": 599.66,
      "end": 601.56,
      "text": "這表示你要"
    },
    {
      "start": 601.56,
      "end": 603.06,
      "text": "要多"
    },
    {
      "start": 603.06,
      "end": 607.3,
      "text": "動一下"
    },
    {
      "start": 607.3,
      "end": 608.1,
      "text": "再來"
    },
    {
      "start": 608.1,
      "end": 609.0,
      "text": "那個"
    },
    {
      "start": 609.0,
      "end": 610.6,
      "text": "暖潮在哪一個地方"
    },
    {
      "start": 610.6,
      "end": 612.1,
      "text": "手探會已經是這樣"
    },
    {
      "start": 612.1,
      "end": 613.3,
      "text": "等一下你要看什麼"
    },
    {
      "start": 613.3,
      "end": 615.3,
      "text": "不要跟你畫好了"
    },
    {
      "start": 615.3,
      "end": 616.3,
      "text": "不要"
    },
    {
      "start": 616.3,
      "end": 617.9,
      "text": "他是這樣"
    },
    {
      "start": 617.9,
      "end": 620.3,
      "text": "這樣轉轉到這邊"
    },
    {
      "start": 620.3,
      "end": 621.9,
      "text": "暖潮看完才這個地方"
    },
    {
      "start": 621.9,
      "end": 623.8,
      "text": "足弓在這個地方"
    },
    {
      "start": 623.8,
      "end": 626.3,
