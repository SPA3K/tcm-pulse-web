    {
      "start": 468.25,
      "end": 469.25,
      "text": "他可能不是"
    },
    {
      "start": 469.25,
      "end": 471.25,
      "text": "是因為你慢性過敏"
    },
    {
      "start": 472.25,
      "end": 474.13,
      "text": "那尺脉這個地方"
    },
    {
      "start": 474.13,
      "end": 475.29,
      "text": "就轉到這邊"
