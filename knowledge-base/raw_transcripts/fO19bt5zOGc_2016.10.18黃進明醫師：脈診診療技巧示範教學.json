    {
      "start": 526.23,
      "end": 527.03,
      "text": "你陰性"
    },
    {
      "start": 527.03,
      "end": 528.03,
      "text": "就是要用"
    },
    {
      "start": 528.03,
      "end": 529.03,
      "text": "那個"
    },
    {
      "start": 529.03,
      "end": 531.03,
      "text": "滋陰涼血的藥"
    },
    {
      "start": 531.03,
      "end": 533.03,
      "text": "那他不是虛證人"
    },
    {
      "start": 533.03,
      "end": 534.03,
      "text": "虛證是到最後"
    },
    {
      "start": 534.03,
      "end": 535.03,
      "text": "你這些陰性"
    },
    {
      "start": 535.03,
      "end": 535.73,
      "text": "去掉的時候"
    },
    {
      "start": 535.73,
      "end": 537.03,
      "text": "你才可以去補"
    },
    {
      "start": 537.03,
      "end": 538.83,
      "text": "結果我本來用那個"
