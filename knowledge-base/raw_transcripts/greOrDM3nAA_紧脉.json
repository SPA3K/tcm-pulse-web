    },
    {
      "start": 22.0,
      "end": 23.0,
      "text": "脉爵也"
    },
    {
      "start": 23.0,
      "end": 25.0,
      "text": "寥寥入齒來"
    },
    {
      "start": 25.0,
      "end": 26.0,
      "text": "催視也"
    },
    {
      "start": 26.0,
      "end": 27.0,
      "text": "如械"
